{
    "python-envs.pythonProjects": [
        {
            "path": "lib/tokens",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],

    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.history/**": true,
        "**/.next/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/coverage/**": true,
        "**/*.map": true,
        "**/*.meta": true,
        "**/*.sst": true
    },

    "files.exclude": {
        "**/.git": true,
        "**/.history": true,
        "**/.next": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/coverage": true,
        "**/*.map": true,
        "**/*.meta": true,
        "**/*.sst": true
    },

    "search.exclude": {
        "**/.git": true,
        "**/.history": true,
        "**/.next": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/coverage": true,
        "**/*.map": true,
        "**/*.meta": true,
        "**/*.sst": true
    }
}